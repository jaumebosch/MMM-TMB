{
  "name": "mmm-tmb",
  "version": "2.0.3",
  "description": "MagicMirror\u00b2 module showing live Barcelona (TMB) bus arrival times",
  "main": "MMM-TMB.js",
  "author": "@jaumebosch",
  "license": "MIT",
  "type": "commonjs",
  "engines": {
    "node": ">=18.0.0"
  },
  "files": [
    "MMM-TMB.css",
    "MMM-TMB.js",
    "node_helper.js",
    "src",
    "tools",
    "translations"
  ],
  "scripts": {
    "test": "node --test test/*.test.js",
    "test:coverage": "node --test --experimental-test-coverage test/*.test.js",
    "smoke": "node tools/smoke.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run lint && npm run format:check && npm test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jaumebosch/MMM-TMB.git"
  },
  "keywords": [
    "MagicMirror",
    "MagicMirror2",
    "module",
    "Public Transport",
    "TMB",
    "Barcelona",
    "bus",
    "iBus",
    "transit"
  ],
  "bugs": {
    "url": "https://github.com/jaumebosch/MMM-TMB/issues"
  },
  "homepage": "https://github.com/jaumebosch/MMM-TMB#readme",
  "dependencies": {},
  "devDependencies": {
    "eslint": "^10.10.0",
    "eslint-plugin-jsdoc": "^50.4.3",
    "globals": "^15.11.0",
    "prettier": "^3.3.3"
  }
}
